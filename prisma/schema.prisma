// Schema completo da CLTech — ver specs/001-portal-candidatura/data-model.md
// 🟢 = ativa na Sprint 1 · 🟡 = modelada, sem comportamento ainda (FR-027)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidade (Auth.js adapter + domínio)
// ---------------------------------------------------------------------------

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

/// 🟢 Identidade de acesso. RN007: e-mail único = um perfil por pessoa.
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  name          String
  passwordHash  String?
  role          UserRole  @default(CANDIDATE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  candidate      Candidate?
  jobsCreated    Job[]                     @relation("JobCreatedBy")
  stageDecisions ApplicationStageHistory[] @relation("StageDecidedBy")

  @@map("User")
}

/// 🟢 Auth.js — vínculo com provedor externo de AUTENTICAÇÃO (GitHub/LinkedIn).
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("Account")
}

/// 🟢 Auth.js — sessão em banco (estratégia "database", permite revogação — R2).
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("VerificationToken")
}

// ---------------------------------------------------------------------------
// Candidato
// ---------------------------------------------------------------------------

/// 🟢 Dados pessoais/profissionais de quem se candidata. 1:1 com User.
model Candidate {
  id           String   @id @default(uuid())
  userId       String   @unique
  phone        String? // cifrado AES-256-GCM (R4) — ver src/server/crypto.ts
  city         String?
  state        String?
  // Perfil profissional (spec 007, FR-701) — digitado ou pré-preenchido pelo currículo.
  headline     String? // título, ex.: "Dev Backend Pleno"
  summary      String?
  technologies String[] @default([]) // entram no match junto com o texto do currículo (FR-708)
  softSkills   String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalAccounts ExternalAccount[]
  githubProfile    GithubProfile?
  resumes          Resume[]
  applications     Application[]
  jobMatches       JobMatch[]
  experiences      Experience[]
  educations       Education[]
  languages        Language[]
  profileLinks     ProfileLink[]

  @@map("Candidate")
}

// ---------------------------------------------------------------------------
// Perfil profissional (spec 007, FR-702). Listas substituídas inteiras a cada
// gravação; `position` guarda a ordem da tela. Datas são mês/ano (dia 1, UTC).
// ---------------------------------------------------------------------------

enum EducationLevel {
  TECNICO
  GRADUACAO
  POS
  MESTRADO
  DOUTORADO
  CURSO_LIVRE
  OUTRO
}

enum LanguageLevel {
  BASICO
  INTERMEDIARIO
  AVANCADO
  FLUENTE
  NATIVO
}

model Experience {
  id          String    @id @default(uuid())
  candidateId String
  position    Int
  company     String
  role        String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("Experience")
}

model Education {
  id          String         @id @default(uuid())
  candidateId String
  position    Int
  institution String
  course      String
  level       EducationLevel
  startDate   DateTime?
  endDate     DateTime?
  inProgress  Boolean        @default(false)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("Education")
}

model Language {
  id          String        @id @default(uuid())
  candidateId String
  position    Int
  name        String
  level       LanguageLevel

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("Language")
}

/// Portfólio, site etc. GitHub/LinkedIn/Lattes seguem em ExternalAccount (coleta).
model ProfileLink {
  id          String @id @default(uuid())
  candidateId String
  position    Int
  label       String
  url         String

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("ProfileLink")
}

enum ExternalProvider {
  GITHUB
  LINKEDIN
  LATTES
}

enum ExternalAccountStatus {
  PENDING
  CONNECTED
  UNAVAILABLE
  DISCONNECTED
}

/// 🟢 Vínculo de COLETA de portfólio — distinto de Account (que é autenticação).
model ExternalAccount {
  id                String                @id @default(uuid())
  candidateId       String
  provider          ExternalProvider
  externalUsername  String?
  url               String? // link público do perfil (LinkedIn/Lattes informados; GitHub derivado do login)
  /// Quando o candidato provou ser dono da conta via OAuth. Null = não verificado (vínculo
  /// antigo por link digitado, ou Lattes, que não tem OAuth).
  verifiedAt        DateTime?
  /// Nome devolvido pelo provedor no OAuth (ex.: nome no LinkedIn), mostrado ao recrutador.
  verifiedName      String?
  status            ExternalAccountStatus @default(PENDING)
  unavailableReason String?
  lastSyncedAt      DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, provider])
  @@map("ExternalAccount")
}

/// 🟢 Snapshot da coleta do GitHub (R6). Substituído inteiro a cada sincronização.
model GithubProfile {
  id                 String   @id @default(uuid())
  candidateId        String   @unique
  publicRepoCount    Int      @default(0)
  languages          Json // [{ name, bytes, share }]
  activityLast90Days Int      @default(0)
  followers          Int      @default(0)
  collectedAt        DateTime

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("GithubProfile")
}

enum ResumeParseStatus {
  NOT_PARSED
  PENDING
  PARSED
  FAILED
}

/// 🟢 Currículo anexado. Histórico preservado (FR-015): nunca apaga versão antiga.
model Resume {
  id               String            @id @default(uuid())
  candidateId      String
  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  isCurrent        Boolean           @default(true)
  uploadedAt       DateTime          @default(now())
  parseStatus      ResumeParseStatus @default(NOT_PARSED)
  extractedText    String? // cifrado AES-256-GCM, mesmo padrão do arquivo (R4/R13 — Sprint 2)

  candidate    Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("Resume")
}

// ---------------------------------------------------------------------------
// Vagas e processo seletivo
// ---------------------------------------------------------------------------

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// 🟢 Vaga publicada pela 3aq. RN002: só publica com technologies + minimumRequirements.
model Job {
  id                  String    @id @default(uuid())
  title               String
  description         String
  company             String
  location            String
  workMode            WorkMode
  seniority           Seniority
  technologies        String[]
  minimumRequirements String
  status              JobStatus @default(DRAFT)
  createdById         String
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  createdBy    User           @relation("JobCreatedBy", fields: [createdById], references: [id])
  stages       ProcessStage[]
  applications Application[]
  jobMatches   JobMatch[]

  @@map("Job")
}

enum ProcessStageType {
  RESUME_ANALYSIS
  CODE_TEST
  GITHUB_ANALYSIS
  HR_INTERVIEW
  TECH_INTERVIEW
  FINAL_OFFER
}

/// 🟢 Etapa ordenada do pipeline de uma vaga.
model ProcessStage {
  id     String           @id @default(uuid())
  jobId  String
  type   ProcessStageType
  order  Int
  config Json             @default("{}")

  job            Job                       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicationsAt Application[]
  stageHistoryAt ApplicationStageHistory[]
  codeDrafts     CodeDraft[]

  @@unique([jobId, order])
  @@map("ProcessStage")
}

enum ApplicationStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  WITHDRAWN
}

enum MatchScoreStatus {
  NOT_CALCULATED
  PENDING
  CALCULATED
  FAILED
}

/// 🟢 Entidade central: inscrição de um candidato em uma vaga.
/// Restrição crítica: único por (candidateId, jobId) — garante FR-022/SC-003 no banco.
model Application {
  id               String            @id @default(uuid())
  candidateId      String
  jobId            String
  resumeId         String
  currentStageId   String
  status           ApplicationStatus @default(IN_PROGRESS)
  matchScore       Int?
  matchScoreStatus MatchScoreStatus  @default(NOT_CALCULATED)
  appliedAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  candidate       Candidate                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job             Job                       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume          Resume                    @relation(fields: [resumeId], references: [id])
  currentStage    ProcessStage              @relation(fields: [currentStageId], references: [id])
  stageHistory    ApplicationStageHistory[]
  evaluations     Evaluation[]
  codeSubmissions CodeSubmission[]
  codeDrafts      CodeDraft[]

  @@unique([candidateId, jobId])
  @@map("Application")
}

/// 🟢 Registro append-only de cada mudança de etapa (FR-029).
model ApplicationStageHistory {
  id              String    @id @default(uuid())
  applicationId   String
  stageId         String
  enteredAt       DateTime  @default(now())
  exitedAt        DateTime?
  decidedByUserId String?
  /// Reunião marcada pelo recrutador ao mover o candidato para uma entrevista (RH/técnica).
  meetingAt  DateTime?
  meetingUrl String?

  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage       ProcessStage @relation(fields: [stageId], references: [id])
  decidedBy   User?        @relation("StageDecidedBy", fields: [decidedByUserId], references: [id])

  @@map("ApplicationStageHistory")
}

/// 🟡 Compatibilidade pré-calculada candidato×vaga, exibida na listagem (RF03).
/// Nunca calculada no caminho da requisição (RNF03) — vazia na Sprint 1 (FR-026).
model JobMatch {
  id            String    @id @default(uuid())
  candidateId   String
  jobId         String
  score         Int
  justification Json
  computedAt    DateTime  @default(now())
  staleSince    DateTime?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@map("JobMatch")
}

// ---------------------------------------------------------------------------
// Teste de código (Sprint 3) — modelado agora por FR-027
// ---------------------------------------------------------------------------

enum ChallengeDifficulty {
  EASY
  MID
  HARD
}

/// 🟡 Enunciado e casos de teste. Mesmos critérios para todos (Princípio II).
model Challenge {
  id               String              @id @default(uuid())
  title            String
  statement        String
  languages        String[]
  difficulty       ChallengeDifficulty
  testCases        Json // [{ input, expectedOutput, hidden }] — hidden nunca sai do servidor
  timeLimitSeconds Int                 @default(10) // teto RNF06
  createdAt        DateTime            @default(now())

  codeDrafts      CodeDraft[]
  codeSubmissions CodeSubmission[]

  @@map("Challenge")
}

/// 🟡 Rascunho com autosave (RF05-A1: tempo esgotado envia o último estado salvo).
model CodeDraft {
  id            String   @id @default(uuid())
  applicationId String
  challengeId   String
  stageId       String?
  language      String
  sourceCode    String // cifrado em repouso
  testRunCount  Int      @default(0)
  startedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  challenge   Challenge     @relation(fields: [challengeId], references: [id])
  stage       ProcessStage? @relation(fields: [stageId], references: [id])

  @@unique([applicationId, challengeId])
  @@map("CodeDraft")
}

enum EvaluationType {
  RESUME_MATCH
  GITHUB_ANALYSIS
  CODE_TEST
}

/// 🟡 Resultado automático SOMENTE-LEITURA (Princípio II). Nenhuma rota de update existe.
/// Trigger de banco BEFORE UPDATE bloqueia alteração mesmo por acesso direto (T008).
model Evaluation {
  id            String         @id @default(uuid())
  applicationId String
  type          EvaluationType
  score         Int
  justification Json
  version       Int            @default(1)
  createdAt     DateTime       @default(now())

  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  codeSubmissions CodeSubmission[]

  @@map("Evaluation")
}

enum CodeExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  TIMEOUT
  SECURITY_VIOLATION
  ERROR
}

enum CodeSubmittedBy {
  CANDIDATE
  TIME_EXPIRED
}

/// 🟡 Submissão do teste técnico. Único por (applicationId, challengeId) = RN006 no banco.
model CodeSubmission {
  id               String              @id @default(uuid())
  applicationId    String
  challengeId      String
  language         String
  sourceCode       String // cifrado em repouso
  submittedAt      DateTime            @default(now())
  executionStatus  CodeExecutionStatus @default(QUEUED)
  retryCount       Int                 @default(0) // máximo 1 — RF06-E1
  gradingStartedAt DateTime? // última vez que a correção começou (QUEUED → RUNNING)
  submittedBy      CodeSubmittedBy     @default(CANDIDATE)
  evaluationId     String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  challenge   Challenge   @relation(fields: [challengeId], references: [id])
  evaluation  Evaluation? @relation(fields: [evaluationId], references: [id])

  @@unique([applicationId, challengeId])
  @@map("CodeSubmission")
}
