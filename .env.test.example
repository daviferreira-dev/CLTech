# Variáveis dos testes de integração — lidas por tests/integration/env.ts.
#
# Este arquivo é versionado: NUNCA coloque credencial real aqui. Para apontar os testes para
# outro banco, copie para `.env.test` (não versionado), que tem prioridade sobre este.
#
# O banco de teste precisa ser SÓ de teste: tests/integration/setup.ts dá TRUNCATE em todas as
# tabelas antes de cada teste. A suíte se recusa a rodar contra o mesmo banco do `.env`.
#
# Postgres local (o mesmo que o CI usa):
#   docker run -d --name cltech-test-db -p 5432:5432 \
#     -e POSTGRES_USER=cltech -e POSTGRES_PASSWORD=cltech -e POSTGRES_DB=cltech_test postgres:16
#   DATABASE_URL="postgresql://cltech:cltech@localhost:5432/cltech_test" pnpm exec prisma migrate deploy
DATABASE_URL="postgresql://cltech:cltech@localhost:5432/cltech_test"
AUTH_SECRET="test-secret-not-for-production"
# Chave só de teste. Nunca use esta em produção.
ENCRYPTION_KEY="dGVzdC1vbmx5LWtleS1ub3QtZm9yLXByb2R1Y3Rpb24="
GITHUB_ID="test"
GITHUB_SECRET="test"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="cltech-curriculos-test"
STORAGE_ACCESS_KEY="test"
STORAGE_SECRET_KEY="test"
