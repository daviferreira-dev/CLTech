# CLTech — variaveis de ambiente
# Copie para .env e preencha. O .env NUNCA e versionado.

# --- Banco de dados ---
DATABASE_URL="postgresql://cltech:cltech@localhost:5432/cltech"

# --- Autenticacao ---
# Assinatura das sessoes. Gere com: openssl rand -base64 32
AUTH_SECRET=""

# --- Criptografia de dados pessoais (LGPD / RNF01) ---
# Chave AES-256 em base64, 32 bytes. Gere com: openssl rand -base64 32
# Perder esta chave torna telefone e curriculos ja gravados irrecuperaveis.
ENCRYPTION_KEY=""

# --- OAuth GitHub (obrigatorio) ---
# Cadastre em: https://github.com/settings/developers
# Callback: http://localhost:3000/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# --- OAuth LinkedIn (opcional) ---
# Exige aprovacao do produto "Sign In with LinkedIn using OpenID Connect".
# Deixar vazio desliga o botao do LinkedIn sem quebrar o login.
LINKEDIN_ID=""
LINKEDIN_SECRET=""

# --- Storage de curriculos (bucket PRIVADO) ---
# Bucket publico exporia documento de candidato e violaria a RN004.
STORAGE_ENDPOINT=""
STORAGE_BUCKET="cltech-curriculos"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- Servico de IA (a partir da Sprint 2) ---
AI_SERVICE_URL="http://localhost:8000"

# --- Aplicacao ---
# Usado nos e-mails e nos redirects de OAuth. Em producao, a URL publica do deploy.
NEXTAUTH_URL="http://localhost:3000"

# --- E-mail transacional (RN005) ---
# Avisa o candidato por e-mail quando passa de etapa, e aprovado ou reprovado.
# Ausente (HOST/USER/PASS vazios) desliga o envio sem quebrar o fluxo.
# Gmail: SMTP_HOST=smtp.gmail.com, porta 587, e SMTP_PASS = "senha de app" (exige
# verificacao em 2 etapas: https://myaccount.google.com/apppasswords), nao a senha normal.
# Outlook/Office 365: SMTP_HOST=smtp.office365.com, porta 587.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Nome exibido como remetente (ex.: "CLTech"), ou endereco completo "Nome <email>". Vazio usa "CLTech".
SMTP_FROM="CLTech"

# --- Sandbox de execucao de codigo (RNF06, a partir da Sprint 3) ---
# VM dedicada rodando Judge0. NAO roda na Vercel - ver research.md R10.
# Dev: SANDBOX_URL="local" roda python/javascript/typescript/java/cpp/go (se a toolchain estiver instalada) direto na maquina, SEM isolamento
# (ignorado com NODE_ENV=production, salvo SANDBOX_ALLOW_LOCAL=1 - o run.bat ja define).
SANDBOX_URL=""
SANDBOX_TOKEN=""
# Spec 005: protege POST /api/internal/code-tests/expire (varredura de prazos vencidos).
CRON_SECRET=
