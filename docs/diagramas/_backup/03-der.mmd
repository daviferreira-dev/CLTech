%% CLTech - Diagrama Entidade-Relacionamento (DER)
%% Fonte: specs/001-portal-candidatura/data-model.md
%% Renderiza direto no GitHub e em https://mermaid.live
%% PK = chave primaria | FK = chave estrangeira | UK = chave unica

erDiagram
    USER ||--o| CANDIDATE : "possui perfil"
    USER ||--o{ ACCOUNT : "autentica por"
    USER ||--o{ SESSION : "mantem"
    USER ||--o{ JOB : "publica"
    USER ||--o{ APPLICATION_STAGE_HISTORY : "decide"

    CANDIDATE ||--o{ EXTERNAL_ACCOUNT : "vincula"
    CANDIDATE ||--o| GITHUB_PROFILE : "tem snapshot"
    CANDIDATE ||--o{ RESUME : "anexa"
    CANDIDATE ||--o{ APPLICATION : "se candidata"
    CANDIDATE ||--o{ JOB_MATCH : "compatibilidade"

    JOB ||--|{ PROCESS_STAGE : "define pipeline"
    JOB ||--o{ APPLICATION : "recebe"
    JOB ||--o{ JOB_MATCH : "compatibilidade"

    APPLICATION }o--|| RESUME : "congela versao"
    APPLICATION }o--|| PROCESS_STAGE : "etapa atual"
    APPLICATION ||--o{ APPLICATION_STAGE_HISTORY : "historico"
    APPLICATION ||--o{ EVALUATION : "avaliacoes"
    APPLICATION ||--o{ CODE_SUBMISSION : "submissoes"
    APPLICATION ||--o{ CODE_DRAFT : "rascunhos"
    PROCESS_STAGE ||--o{ APPLICATION_STAGE_HISTORY : "registrada em"

    CHALLENGE ||--o{ CODE_SUBMISSION : "respondido por"
    CHALLENGE ||--o{ CODE_DRAFT : "rascunhado em"
    CODE_SUBMISSION ||--o| EVALUATION : "gera"

    USER {
        uuid id PK
        text email UK "normalizado minusculo - RN007"
        timestamp emailVerified
        text name
        text passwordHash "Argon2id - nulo se so OAuth"
        enum role "CANDIDATE RECRUITER ADMIN"
        timestamp createdAt
        timestamp updatedAt
    }

    ACCOUNT {
        uuid id PK
        uuid userId FK
        text provider "github linkedin"
        text providerAccountId UK
        text access_token
    }

    SESSION {
        uuid id PK
        uuid userId FK
        text sessionToken UK
        timestamp expires
    }

    CANDIDATE {
        uuid id PK
        uuid userId FK "UK - relacao 1:1"
        text phone "CIFRADO AES-256-GCM"
        text city
        text state
        timestamp createdAt
        timestamp updatedAt
    }

    EXTERNAL_ACCOUNT {
        uuid id PK
        uuid candidateId FK
        enum provider "GITHUB LINKEDIN LATTES"
        text externalUsername
        text url "usado pelo Lattes"
        enum status "PENDING CONNECTED UNAVAILABLE DISCONNECTED"
        text unavailableReason
        timestamp lastSyncedAt
    }

    GITHUB_PROFILE {
        uuid id PK
        uuid candidateId FK "UK"
        int publicRepoCount
        jsonb languages
        int activityLast90Days
        int followers
        timestamp collectedAt
    }

    RESUME {
        uuid id PK
        uuid candidateId FK
        text storageKey "bucket privado"
        text originalFilename
        text mimeType "PDF ou DOCX"
        int sizeBytes "max 5242880"
        boolean isCurrent "so um true por candidato"
        timestamp uploadedAt
        enum parseStatus "NOT_PARSED PENDING PARSED FAILED"
    }

    JOB {
        uuid id PK
        text title
        text description
        text company
        text location
        enum workMode "REMOTE HYBRID ONSITE"
        enum seniority "INTERN JUNIOR MID SENIOR"
        text_array technologies "RN002"
        text minimumRequirements "RN002"
        enum status "DRAFT PUBLISHED CLOSED"
        uuid createdById FK
        timestamp publishedAt
    }

    PROCESS_STAGE {
        uuid id PK
        uuid jobId FK
        enum type "RESUME_ANALYSIS CODE_TEST GITHUB_ANALYSIS HR_INTERVIEW TECH_INTERVIEW FINAL_OFFER"
        int order "UK com jobId"
        jsonb config
    }

    APPLICATION {
        uuid id PK
        uuid candidateId FK "UK com jobId - FR022"
        uuid jobId FK "UK com candidateId - FR022"
        uuid resumeId FK
        uuid currentStageId FK
        enum status "IN_PROGRESS APPROVED REJECTED WITHDRAWN"
        int matchScore "nulo na Sprint 1"
        enum matchScoreStatus "NOT_CALCULATED PENDING CALCULATED FAILED"
        timestamp appliedAt
        timestamp updatedAt
    }

    APPLICATION_STAGE_HISTORY {
        uuid id PK
        uuid applicationId FK
        uuid stageId FK
        timestamp enteredAt
        timestamp exitedAt
        uuid decidedByUserId FK "nulo se automatico"
    }

    JOB_MATCH {
        uuid id PK
        uuid candidateId FK "UK com jobId"
        uuid jobId FK "UK com candidateId"
        int score "0 a 100"
        jsonb justification
        timestamp computedAt
        timestamp staleSince
    }

    EVALUATION {
        uuid id PK
        uuid applicationId FK
        enum type "RESUME_MATCH GITHUB_ANALYSIS CODE_TEST"
        int score "IMUTAVEL - trigger BEFORE UPDATE"
        jsonb justification
        int version "reprocessamento insere nova linha"
        timestamp createdAt
    }

    CHALLENGE {
        uuid id PK
        text title
        text statement
        text_array languages
        enum difficulty "EASY MID HARD"
        jsonb testCases "hidden nunca sai do servidor"
        int timeLimitSeconds "max 10 - RNF06"
    }

    CODE_DRAFT {
        uuid id PK
        uuid applicationId FK "UK com challengeId"
        uuid challengeId FK "UK com applicationId"
        text language
        text sourceCode "CIFRADO"
        int testRunCount
        timestamp startedAt
        timestamp updatedAt
    }

    CODE_SUBMISSION {
        uuid id PK
        uuid applicationId FK "UK com challengeId - RN006"
        uuid challengeId FK "UK com applicationId - RN006"
        text language
        text sourceCode "CIFRADO"
        timestamp submittedAt
        enum executionStatus "QUEUED RUNNING COMPLETED TIMEOUT SECURITY_VIOLATION ERROR"
        int retryCount "max 1 - RF06 E1"
        enum submittedBy "CANDIDATE TIME_EXPIRED"
        uuid evaluationId FK
    }
