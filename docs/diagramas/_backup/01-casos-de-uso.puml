@startuml casos-de-uso
' CLTech - Diagrama de Casos de Uso
' Fonte: ERS secao 2.1 (RF01 a RF09) e specs/001-portal-candidatura/spec.md
' Renderizar em: https://www.plantuml.com/plantuml  ou  extensao PlantUML do VS Code

skinparam backgroundColor White
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F7F9FC
  BorderColor #3B6EA5
  ArrowColor #3B6EA5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2F4858
}
left to right direction

actor "Candidato" as CAND
actor "Recrutador\n(RH / Tech Lead)" as REC
actor "Administrador" as ADM

actor "API do GitHub" as GH <<sistema externo>>
actor "Motor de IA" as IA <<sistema>>
actor "Sandbox" as SB <<sistema>>

' Administrador tem todas as permissoes do Recrutador
ADM --|> REC

rectangle "CLTech - Plataforma de Selecao Automatizada" {

  ' ---------- Acesso ----------
  usecase "UC01\nAutenticar e Cadastrar" as UC01
  usecase "Entrar com\nGitHub / LinkedIn" as UC01a
  usecase "Criar conta com\ne-mail e senha" as UC01b

  ' ---------- Candidato ----------
  usecase "UC02\nGerenciar Perfil" as UC02
  usecase "Anexar Curriculo" as UC02a
  usecase "Conectar Conta Externa" as UC02b
  usecase "Coletar dados\ndo GitHub" as UC02c

  usecase "UC03\nBuscar e Candidatar-se\na Vaga" as UC03
  usecase "Filtrar vagas" as UC03a
  usecase "Acompanhar minhas\ncandidaturas" as UC03b

  usecase "UC05\nRealizar Teste\nde Codigo" as UC05

  ' ---------- Recrutador ----------
  usecase "UC04\nConfigurar Pipeline\nda Vaga" as UC04
  usecase "UC07\nVisualizar Painel\nde Recrutamento" as UC07
  usecase "UC08\nAnalisar Candidato\nem Detalhe" as UC08
  usecase "Registrar decisao\n(avancar / reprovar)" as UC08a
  usecase "UC09\nBuscar Historico\nde Candidatos" as UC09

  ' ---------- Automaticos ----------
  usecase "UC10\nTriar Curriculo\nautomaticamente" as UC10
  usecase "UC06\nCorrigir Submissao\ne Gerar Relatorio" as UC06
  usecase "Executar codigo\nem sandbox" as UC06a
  usecase "UC11\nEnviar Feedback\nao Candidato" as UC11
}

' ---------- Associacoes ----------
CAND --> UC01
REC  --> UC01

CAND --> UC02
CAND --> UC03
CAND --> UC05

REC --> UC04
REC --> UC07
REC --> UC08
REC --> UC09

IA --> UC10
IA --> UC06
IA --> UC11
SB --> UC06a
GH --> UC02c

' ---------- Relacionamentos UML ----------
UC01 <.. UC01a : <<extend>>
UC01 <.. UC01b : <<extend>>

UC02 ..> UC01  : <<include>>
UC02 <.. UC02a : <<extend>>
UC02 <.. UC02b : <<extend>>
UC02b ..> UC02c : <<include>>

UC03 ..> UC01  : <<include>>
UC03 ..> UC02a : <<include>>
UC03 <.. UC03a : <<extend>>
UC03 <.. UC03b : <<extend>>
UC03 ..> UC10  : <<include>>

UC05 ..> UC06  : <<include>>
UC06 ..> UC06a : <<include>>
UC06 ..> UC11  : <<include>>

UC07 ..> UC01  : <<include>>
UC08 ..> UC07  : <<include>>
UC08 <.. UC08a : <<extend>>
UC09 ..> UC01  : <<include>>

note bottom of UC10
  RN001 - Todo curriculo passa pela IA
  antes de aparecer para o RH.
  Nao existe listagem "bruta".
end note

note bottom of UC06a
  RNF06 - Sandbox sem rede,
  sem disco do host, 10s por execucao.
  Nao roda na Vercel (research.md R10).
end note

note right of UC08a
  RN003 - O recrutador decide,
  mas nao altera o score.
end note

@enduml
