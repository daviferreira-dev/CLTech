@startuml atividade-candidatura
' CLTech - Diagrama de Atividade: Candidatura a uma Vaga [RF03 + RN001]
' Conferido contra src/server/applications/apply.ts
' Renderizar: java -jar plantuml.jar -charset UTF-8 Atividade_1_Candidatura.puml

title Candidatura a uma Vaga — RF03

skinparam backgroundColor White
skinparam shadowing false
skinparam ActivityBackgroundColor #F7F9FC
skinparam ActivityBorderColor #3B6EA5
skinparam ActivityDiamondBackgroundColor #FFF8E7
skinparam ActivityDiamondBorderColor #C2903A

|#F3F6FA|Candidato|
start
:Acessa a listagem de vagas;
note right: Listagem pública,\nnão exige login

|#FFFFFF|Sistema|
:Consulta vagas publicadas;
:Exibe título, empresa, local,\nmodalidade e tecnologias;
note right: Logado e com currículo, vê também\no percentual de compatibilidade\njá calculado (nunca calculado na hora)

|Candidato|
:Aplica busca e filtros\n(texto, tecnologia, modalidade, senioridade);

|Sistema|
:Recalcula a lista;
if (Há vagas correspondentes?) then (não)
  :Informa que nenhuma vaga corresponde\ne sugere ampliar a busca;
  note right: RF03-A1
  |Candidato|
  :Ajusta os filtros;
  detach
else (sim)
endif

|Candidato|
:Abre os detalhes da vaga;

|Sistema|
:Exibe descrição, requisitos\ne etapas do processo seletivo;

|Candidato|
:Clica em Candidatar-se;

|Sistema|
if (Está autenticado?) then (não)
  |Candidato|
  :É levado ao login ou cadastro;
  :Conclui a autenticação;
  |Sistema|
  :Retorna à vaga de origem;
else (sim)
endif

if (Possui currículo vigente?) then (não)
  :Orienta a enviar o currículo\nantes de concluir;
  |Candidato|
  :Envia o currículo em "Meu Perfil";
  detach
else (sim)
endif

|Sistema|
if (A vaga ainda está aberta?) then (não)
  :Informa que a vaga fechou;
  stop
else (sim)
endif

:Calcula o score de compatibilidade\n(tecnologias da vaga x currículo, perfil e GitHub);
note right
  RN001 — a triagem automática acontece
  ANTES da candidatura existir.
  Sem nenhum sinal, o score é 0, mas a
  avaliação existe do mesmo jeito.
end note

:Em uma única transação, grava a candidatura\nna 1ª etapa, o histórico de etapa\ne a Avaliação (RESUME_MATCH);
note right
  A unicidade candidato + vaga é garantida
  pelo índice único do banco, não por consulta
  prévia: é isso que torna envios simultâneos seguros.
  A Avaliação é imutável (RN003).
end note

if (O índice único foi violado?) then (sim)
  :Recusa e exibe o status atual\ndo processo do candidato;
  note right: RF03-A2
  stop
else (não)
endif

|Candidato|
:Vê "Candidatura enviada" e acompanha\nem "Minhas Candidaturas";

|Sistema|
:Disponibiliza a candidatura, já com o score,\nno painel do recrutador;

stop

@enduml
