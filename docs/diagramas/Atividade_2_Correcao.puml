@startuml atividade-correcao
' CLTech - Diagrama de Atividade: Teste de Código e Correção Automática [RF05 + RF06]
' Conferido contra src/server/code-test/session.ts e grading.ts
' Renderizar: java -jar plantuml.jar -charset UTF-8 Atividade_2_Correcao.puml

title Teste de Código e Correção Automática — RF05 + RF06

skinparam backgroundColor White
skinparam shadowing false
skinparam ActivityBackgroundColor #F7F9FC
skinparam ActivityBorderColor #3B6EA5
skinparam ActivityDiamondBackgroundColor #FFF8E7
skinparam ActivityDiamondBorderColor #C2903A

|#FFFFFF|Recrutador|
start
:Avança a candidatura para a etapa\nTeste de Código;

|#F3F6FA|Candidato|
:Abre o desafio em "Minhas Candidaturas";

|#FFFFFF|Sistema|
if (A candidatura está na etapa Teste de Código?) then (não)
  :Informa que o desafio\nainda não está disponível;
  stop
else (sim)
endif
:Na primeira abertura, cria o rascunho\ne grava o horário de início;
note right: O prazo é contado pelo relógio\ndo servidor: reabrir não reinicia
:Exibe enunciado, casos visíveis,\nlinguagens e tempo restante;
note right: Casos ocultos nunca saem do servidor

repeat
  |Candidato|
  :Escreve o código;
  |Sistema|
  :Salva o rascunho automaticamente (cifrado);
  |Candidato|
  if (Clica em Testar?) then (sim)
    |Sistema|
    if (Ainda há execuções? (padrão 20)) then (não)
      :Recusa e informa que resta submeter;
    else (sim)
      |#FDF4F4|Sandbox|
      :Executa contra os casos visíveis;
      |Sistema|
      if (Sandbox respondeu?) then (não)
        :Informa indisponibilidade,\nsem consumir execução;
      else (sim)
        :Conta a execução;
        |Candidato|
        :Vê o resultado de cada caso\nou o erro de compilação;
        note right: RF05-A2
      endif
    endif
  else (não)
  endif
repeat while (Submeteu ou o tempo acabou?) is (ainda não) not (sim)

|Sistema|
if (O tempo esgotou?) then (sim)
  :Submete o último rascunho salvo\n(por tempo esgotado);
  note right
    RF05-A1. Se a aba foi fechada,
    uma rotina periódica faz a mesma verificação.
  end note
else (não)
  :Submete o código enviado pelo candidato;
endif

:Tenta gravar a submissão\n(índice único candidatura + desafio);
if (Já existia submissão?) then (sim)
  :Recusa o reenvio;
  note right: RN006 — tentativa única (RF05-E1)
  stop
else (não)
endif
:Põe a submissão na fila de correção;
|Candidato|
:Vê "Correção em andamento";

|Sandbox|
:Executa contra TODOS os casos,\ninclusive os ocultos;
note right
  RNF06: sem rede, com limite de tempo.
  Estouro de tempo ou erro de execução
  conta como caso reprovado (RF06-A1).
end note

|Sistema|
if (Falha técnica do sandbox?) then (sim)
  if (Já houve uma retentativa?) then (não)
    :Reprocessa uma única vez;
    note right: RF06-E1
    detach
  else (sim)
    :Marca a submissão como erro de correção;
    :Registra a falha no log monitorado\npela equipe técnica;
    |Candidato|
    :Vê "Correção pendente";
    stop
  endif
else (não)
endif

|Sistema|
:Calcula o percentual de casos aprovados;
:Grava a Avaliação (CODE_TEST) com o score;
note right
  RN003 — inserida, nunca alterada.
  Trigger BEFORE UPDATE bloqueia mudança
  até por acesso direto ao banco.
end note

fork
  |Candidato|
  :Vê "Correção concluída", sem a nota;
fork again
  |Recrutador|
  :Vê o relatório: score e resultado\nde cada caso;
  :Decide avançar ou reprovar;
  note right: A correção nunca move a etapa sozinha
end fork

stop

@enduml
